{
  "name": "interactive-resume",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "export:cv:th": "node scripts/export-cv-th-pdf.mjs",
    "export:cv:en": "node scripts/export-cv-en-pdf.mjs",
    "export:cv:combined": "node scripts/export-cv-combined-pdf.mjs",
    "export:cv": "npm run export:cv:th && npm run export:cv:en && npm run export:cv:combined",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d dist",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.164.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.3.0",
    "playwright": "^1.54.2",
    "prettier": "^3.6.2",
    "vite": "^5.4.10"
  }
}
